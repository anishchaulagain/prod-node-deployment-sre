# ============================================
# DATABASE CONFIGURATION (Existing)
# ============================================
DB_TYPE=mysql
DB_HOST=your-database-host.example.com
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your_database

# ============================================
# JENKINS ENVIRONMENT VARIABLES
# ============================================

# Docker Configuration
JENKINS_IMAGE_NAME=node-deploy
JENKINS_CONTAINER_NAME=express-api
JENKINS_PORT=8000

# EC2 Deployment Configuration
JENKINS_DEPLOY_HOST=your-ec2-ip.example.com  # Update with your EC2 IP
JENKINS_DEPLOY_DIR=/home/ubuntu/deploy
JENKINS_LOG_DIR=/home/ubuntu/deploy/logs
JENKINS_MAX_LOGS=5
JENKINS_BACKUP_TAG=backup
JENKINS_HEALTH_ENDPOINT=/health

# ============================================
# TERRAFORM ENVIRONMENT VARIABLES
# ============================================

# AWS Configuration
TF_AWS_REGION=us-east-1
TF_INSTANCE_TYPE=t3.micro
TF_KEY_NAME=your-ec2-key-pair-name  # REQUIRED - Update with your EC2 key pair
TF_INSTANCE_COUNT=3
TF_APP_PORT=8000

# Security Group Configuration
TF_SG_NAME=basic-ec2-sg
TF_SG_DESCRIPTION=Allow SSH and app port

# EC2 Instance Configuration
TF_INSTANCE_NAME_PREFIX=basic-ec2
